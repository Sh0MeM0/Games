{
    email {$ACME_EMAIL}
    admin off
}

{$DOMAIN} {
    request_body {
        max_size {$MAX_REQUEST_SIZE:51MB}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy server:8000
}
