{
  "name": "potok-team",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Бесплатное приложение для задач и учета времени команды",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
