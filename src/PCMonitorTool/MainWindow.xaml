<Window x:Class="PCMonitorTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Monitor Tool" Width="1024" Height="730" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="#F5F7FA" Foreground="#19283B" Language="ru-RU" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#1D3446"/>
            <Setter Property="BorderBrush" Value="#BAC7D0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/><Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#057568"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#B36500"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.75"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.52"/></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#43586A"/><Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#006758"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#0E8572"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#E7F0EF"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#D6E9E5"/></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E3E9EE"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F8FA"/>
            <Setter Property="RowHeight" Value="32"/><Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="7,3"/><Setter Property="Background" Value="#EAF0F4"/><Setter Property="Foreground" Value="#324D60"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="7,2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#4C6272"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#203844" Padding="22,15">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SessionButton" Click="SessionButton_Click" Content="Начать сеанс" Background="#0F7466" Foreground="White" BorderBrush="#6CB8AD" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="PC Monitor Tool" FontSize="25" FontWeight="SemiBold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#A3B3BC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Сеанс остановлен" Foreground="#E0EDF1"/></StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="18,10,18,8" SelectionChanged="WorkspaceTabs_SelectionChanged"
                    BorderBrush="#CFD9E0" Background="White" Padding="15">
            <TabItem Header="Обзор">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Margin="0,0,0,18" Background="#EAF3F1" BorderBrush="#CADFD9" BorderThickness="1" CornerRadius="5" Padding="13,10">
                        <StackPanel><TextBlock x:Name="ModeText" Text="Автоматические снимки выключены" Foreground="#154F47" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailText" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Время в приложениях сегодня" Style="{StaticResource Heading}"/>
                    <TextBlock Grid.Row="2" x:Name="UsageHint" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="3" x:Name="TotalText" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="4" x:Name="UsageGrid" AutomationProperties.Name="Время в приложениях сегодня"><DataGrid.Columns>
                        <DataGridTextColumn Header="Приложение" Binding="{Binding Process}" Width="*"/>
                        <DataGridTextColumn Header="Активное время" Binding="{Binding Duration}" SortMemberPath="Seconds" Width="180"/>
                    </DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Скриншоты">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><Button x:Name="CaptureButton" DockPanel.Dock="Right" Content="Сделать скриншот сейчас" Click="Capture_Click"
                            IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Чтобы сделать снимок, начните сеанс учёта."
                            AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
                        <TextBlock Text="Снимки экранов" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="ScreenshotList" DisplayMemberPath="Name" SelectionChanged="ScreenshotList_SelectionChanged" AutomationProperties.Name="Файлы снимков"/>
                        <Border Grid.Column="1" Margin="10,0,0,0" Background="#EAF0F3" CornerRadius="4" Padding="8"><Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Предпросмотр выбранного снимка"/>
                            <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Text="Сохранённых снимков пока нет" Style="{StaticResource Hint}"/>
                        </Grid></Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Клики">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Тест кликов" Style="{StaticResource Heading}"/>
                    <TextBlock Grid.Row="1" Text="Во время сеанса щелчок внутри площадки записывает кнопку мыши и её координаты относительно площадки." Style="{StaticResource Hint}"/>
                    <Border x:Name="ClickSurface" Grid.Row="2" Height="70" Margin="0,10,0,12" Background="#E6F3EF" BorderBrush="#4F978A" BorderThickness="1" CornerRadius="5" MouseDown="ClickSurface_MouseDown" Cursor="Cross" AutomationProperties.Name="Площадка тестирования мыши">
                        <TextBlock x:Name="ClickHint" Text="Для проверки начните сеанс" Foreground="#165D50" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid x:Name="ClickGrid" Grid.Row="3" AutomationProperties.Name="Журнал тестовых кликов"><DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="Событие" Binding="{Binding Kind}" Width="170"/><DataGridTextColumn Header="Координаты площадки" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Файлы">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Съёмные накопители" Style="{StaticResource Heading}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="Журнал подключений и отключений. События файловой системы появляются, если их учёт включён в настройках." Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="2" x:Name="FileGrid" AutomationProperties.Name="События съёмных накопителей"><DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="Событие" Binding="{Binding Kind}" Width="185"/><DataGridTextColumn Header="Накопитель и файл" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Приложения">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Журнал приложений" Style="{StaticResource Heading}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="Запуск и завершение процессов, а также интервалы работы в активном приложении." Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="2" x:Name="AppGrid" AutomationProperties.Name="События приложений"><DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="Событие" Binding="{Binding Kind}" Width="170"/><DataGridTextColumn Header="Подробности" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Настройки">
                <StackPanel><TextBlock Text="Параметры мониторинга" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Интервалы наблюдения, папка данных, горячая клавиша и запуск при входе в Windows." Margin="0,0,0,12"/>
                    <Button HorizontalAlignment="Left" Content="Открыть настройки" Click="Settings_Click"/></StackPanel>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#EDF2F4" BorderBrush="#CBD8DF" BorderThickness="0,1,0,0" Padding="18,7"><DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Обновить" Click="Refresh_Click"/>
                <Button Content="Открыть папку" Click="OpenFolder_Click" Margin="6,0,0,0"/><Button Content="Экспорт в ZIP" Click="Export_Click" Margin="6,0,0,0"/>
                <Button Content="Выход" Click="Exit_Click" Margin="6,0,0,0" ToolTip="Остановить учёт и закрыть программу"/></StackPanel>
            <TextBlock x:Name="FeedbackText" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </DockPanel></Border>
    </Grid>
</Window>
