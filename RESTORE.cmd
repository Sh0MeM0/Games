@echo off
setlocal DisableDelayedExpansion
set "PDFMASTER_RESTORE_DIR=%~dp0"
echo PDF Master - restore download
powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; Set-StrictMode -Version 2.0; $script:tmp=$null; function FileHash($p) { $s=[IO.File]::OpenRead($p); $h=[Security.Cryptography.SHA256]::Create(); try { return ([BitConverter]::ToString($h.ComputeHash($s))).Replace('-','').ToLowerInvariant() } finally { $s.Dispose(); $h.Dispose() } }; function SafeName($n) { if ([string]::IsNullOrWhiteSpace($n) -or $n -ne [IO.Path]::GetFileName($n) -or $n.IndexOfAny([IO.Path]::GetInvalidFileNameChars()) -ge 0 -or $n -match '[. ]$' -or $n -match '^(?i:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)') { throw 'Invalid file name in manifest.' } }; function Restore { $root=$env:PDFMASTER_RESTORE_DIR; $m=[IO.File]::ReadAllText((Join-Path $root 'manifest.json')) | ConvertFrom-Json; SafeName ([string]$m.filename); if ([long]$m.size -le 0 -or [string]$m.sha256 -notmatch '^[0-9a-fA-F]{64}$' -or @($m.parts).Count -lt 1) { throw 'Invalid manifest.' }; $target=Join-Path $root ([string]$m.filename); if ([IO.File]::Exists($target)) { if ((Get-Item -Force -LiteralPath $target).Length -eq [long]$m.size -and (FileHash $target) -eq [string]$m.sha256) { Write-Host 'Already restored and verified:'; Write-Host $target; return } }; $stem=[IO.Path]::GetFileNameWithoutExtension([string]$m.filename); $ext=[IO.Path]::GetExtension([string]$m.filename); $i=2; while (Test-Path -LiteralPath $target) { $target=Join-Path $root ($stem+' ('+$i+')'+$ext); $i++ }; $script:tmp=Join-Path $root ('.pdfmaster-'+[Guid]::NewGuid().ToString('N')+'.tmp'); $out=[IO.File]::Open($script:tmp,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None); try { foreach ($part in @($m.parts)) { SafeName ([string]$part.filename); if ([long]$part.size -lt 0 -or [string]$part.sha256 -notmatch '^[0-9a-fA-F]{64}$') { throw 'Invalid part metadata.' }; $p=Join-Path $root ([string]$part.filename); Write-Host ('Checking '+$part.filename); if (-not [IO.File]::Exists($p)) { throw ('Missing part: '+$part.filename) }; if ((Get-Item -Force -LiteralPath $p).Length -ne [long]$part.size -or (FileHash $p) -ne [string]$part.sha256) { throw ('Damaged part: '+$part.filename) }; $partStream=[IO.File]::OpenRead($p); try { $partStream.CopyTo($out,1048576) } finally { $partStream.Dispose() } } } finally { $out.Dispose() }; Write-Host 'Verifying complete file...'; if ((Get-Item -Force -LiteralPath $script:tmp).Length -ne [long]$m.size -or (FileHash $script:tmp) -ne [string]$m.sha256) { throw 'Complete file checksum mismatch.' }; [IO.File]::Move($script:tmp,$target); $script:tmp=$null; Write-Host 'SUCCESS: restored and SHA256 verified.'; Write-Host $target }; try { Restore; exit 0 } catch { Write-Host ('ERROR: '+$_.Exception.Message); Write-Host 'Extract the entire downloaded ZIP to a writable folder, then run RESTORE.cmd again.'; exit 1 } finally { if ($null -ne $script:tmp -and [IO.File]::Exists($script:tmp)) { [IO.File]::Delete($script:tmp) } }"
set "PDFMASTER_RESTORE_EXIT=%ERRORLEVEL%"
echo.
if /I "%~1"=="/quiet" goto done
pause
:done
exit /b %PDFMASTER_RESTORE_EXIT%
