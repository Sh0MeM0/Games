<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AcVersion Condition="'$(AcVersion)' == ''">23.1.0</AcVersion>
    <OutputPath>bin/$(Configuration)/$(AcVersion)/</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.8.8</Version>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Profiles.Core/Profiles.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET" Version="$(AcVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET.Core" Version="$(AcVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET.Model" Version="$(AcVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
</Project>
