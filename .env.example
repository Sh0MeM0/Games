# Скопируйте в .env и заполните. Файл .env не коммитить; chmod 600 .env.
DOMAIN=archive.example.org
ACME_EMAIL=admin@example.org
# Генератор: python3 -c "import secrets; print(secrets.token_hex(32))"
# Используйте hex, чтобы пароль корректно помещался в DATABASE_URL.
POSTGRES_PASSWORD=
# Другой случайный ключ: python3 -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=
MAX_UPLOAD_MB=50
# Установите немного больше MAX_UPLOAD_MB для multipart-обёртки.
MAX_REQUEST_SIZE=51MB
LOCK_TIMEOUT_SECONDS=180
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
