# Development uses a separate populated demo workspace by default.
# For a private workspace without sample data, set false and choose a password.
POTOK_DEMO_MODE=false
POTOK_ADMIN_EMAIL=admin@example.com
POTOK_ADMIN_PASSWORD=
POTOK_DB_PATH=data/potok.sqlite
PORT=3001
# Set true only when serving the production app through HTTPS.
POTOK_SECURE_COOKIE=false
# With one local HTTPS reverse proxy, set 1 and forward X-Forwarded-Proto.
POTOK_TRUST_PROXY=0
